---
interface CommandItem {
  category: string;
  goal: string;
  command: string;
  notes?: string;
}

const commands: CommandItem[] = [
  {
    category: "Setup",
    goal: "Configure username",
    command: 'git config --global user.name "Your Name"',
  },
  {
    category: "Setup",
    goal: "Configure email",
    command: 'git config --global user.email "you@example.com"',
  },
  { category: "Setup", goal: "View all config settings", command: "git config --list" },
  { category: "Start", goal: "Clone repository", command: "git clone <repository-url>" },
  { category: "Start", goal: "Initialize new repository", command: "git init" },
  {
    category: "Branching",
    goal: "Create & switch to new branch",
    command: "git switch -c <branch-name>",
  },
  { category: "Branching", goal: "Switch to existing branch", command: "git switch <branch-name>" },
  { category: "Branching", goal: "List all local & remote branches", command: "git branch -a" },
  {
    category: "Branching",
    goal: "Delete local branch safely",
    command: "git branch -d <branch-name>",
  },
  { category: "Branching", goal: "Toggle back to previous branch", command: "git switch -" },
  { category: "Staging", goal: "View status of workspace", command: "git status" },
  { category: "Staging", goal: "Stage all modified & new files", command: "git add ." },
  { category: "Staging", goal: "Stage specific file", command: "git add <file-path>" },
  { category: "Staging", goal: "Interactive patch staging", command: "git add -p" },
  {
    category: "Commit",
    goal: "Create commit with message",
    command: 'git commit -m "feat: description"',
  },
  {
    category: "Commit",
    goal: "Amend last commit without changing message",
    command: "git commit --amend --no-edit",
  },
  {
    category: "Commit",
    goal: "Stage all tracked files & commit",
    command: 'git commit -am "fix: description"',
  },
  { category: "Syncing", goal: "Fetch remote branch references", command: "git fetch origin" },
  {
    category: "Syncing",
    goal: "Pull remote changes & rebase local commits",
    command: "git pull --rebase origin <branch>",
  },
  {
    category: "Syncing",
    goal: "Push local branch & set upstream tracking",
    command: "git push -u origin <branch-name>",
  },
  {
    category: "Syncing",
    goal: "Safe force push (verifies remote state)",
    command: "git push --force-with-lease",
  },
  {
    category: "Stash",
    goal: "Save changes to stash with message",
    command: 'git stash push -m "<label>"',
  },
  { category: "Stash", goal: "Pop latest stash and remove from list", command: "git stash pop" },
  { category: "Stash", goal: "List all saved stashes", command: "git stash list" },
  {
    category: "Undoing",
    goal: "Discard unstaged modifications in file",
    command: "git restore <file-path>",
  },
  {
    category: "Undoing",
    goal: "Unstage a staged file",
    command: "git restore --staged <file-path>",
  },
  {
    category: "Undoing",
    goal: "Soft reset (undo commit, keep staged)",
    command: "git reset --soft HEAD~1",
  },
  {
    category: "Undoing",
    goal: "Hard reset (discard commits & local changes)",
    command: "git reset --hard HEAD~1",
  },
  {
    category: "Undoing",
    goal: "Safely revert a commit with a new commit",
    command: "git revert <commit-hash>",
  },
  {
    category: "History",
    goal: "1-Line commit log graph",
    command: "git log --oneline --graph --decorate --all",
  },
  { category: "History", goal: "Inspect commit details & diff", command: "git show <commit-hash>" },
  {
    category: "History",
    goal: "Line-by-line author attribution",
    command: "git blame <file-path>",
  },
];

const categories = ["All", ...Array.from(new Set(commands.map((c) => c.category)))];
---

<div class="git-table-container">
  <!-- Search & Category Filters -->
  <div class="filter-controls">
    <div class="search-box">
      <svg
        class="search-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="git-table-search"
        placeholder="Filter commands by keyword (e.g. branch, commit, undo, stash)..."
        aria-label="Filter Git commands"
      />
      <button id="clear-search" class="clear-btn" aria-label="Clear search" hidden>&times;</button>
    </div>

    <div class="category-pills" id="category-pills">
      {
        categories.map((cat, idx) => (
          <button type="button" class={`pill-btn ${idx === 0 ? "active" : ""}`} data-category={cat}>
            {cat}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Table -->
  <div class="table-wrapper">
    <table class="git-quick-table" id="git-quick-table">
      <thead>
        <tr>
          <th class="col-category">Category</th>
          <th class="col-goal">Goal / Action</th>
          <th class="col-command">Command</th>
        </tr>
      </thead>
      <tbody>
        {
          commands.map((item) => (
            <tr
              data-category={item.category}
              data-search={`${item.category} ${item.goal} ${item.command}`.toLowerCase()}>
              <td class="col-category">
                <span class="category-badge">{item.category}</span>
              </td>
              <td class="col-goal goal-cell">{item.goal}</td>
              <td class="col-command command-cell">
                <div class="code-copy-wrapper">
                  <code>{item.command}</code>
                  <button
                    type="button"
                    class="copy-cmd-btn"
                    data-code={item.command}
                    title="Copy command"
                    aria-label="Copy command">
                    <svg
                      class="icon-copy"
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <svg
                      class="icon-check"
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <div id="no-results" class="no-results-msg" hidden>
      🔍 No matching Git commands found for your filter.
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("git-table-search") as HTMLInputElement | null;
    const clearBtn = document.getElementById("clear-search") as HTMLButtonElement | null;
    const pillBtns = document.querySelectorAll<HTMLButtonElement>("#category-pills .pill-btn");
    const tableRows = document.querySelectorAll<HTMLTableRowElement>("#git-quick-table tbody tr");
    const noResultsMsg = document.getElementById("no-results");
    const copyBtns = document.querySelectorAll<HTMLButtonElement>(".copy-cmd-btn");

    let activeCategory = "All";
    let searchQuery = "";

    function filterTable() {
      let visibleCount = 0;

      tableRows.forEach((row) => {
        const rowCategory = row.getAttribute("data-category") || "";
        const rowSearchText = row.getAttribute("data-search") || "";

        const matchesCategory = activeCategory === "All" || rowCategory === activeCategory;
        const matchesSearch = !searchQuery || rowSearchText.includes(searchQuery.toLowerCase());

        if (matchesCategory && matchesSearch) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noResultsMsg) {
        noResultsMsg.hidden = visibleCount > 0;
      }

      if (clearBtn) {
        clearBtn.hidden = !searchQuery;
      }
    }

    // Category button clicks
    pillBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        pillBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeCategory = btn.getAttribute("data-category") || "All";
        filterTable();
      });
    });

    // Search input typing
    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      filterTable();
    });

    // Clear search button
    clearBtn?.addEventListener("click", () => {
      if (searchInput) {
        searchInput.value = "";
        searchQuery = "";
        filterTable();
        searchInput.focus();
      }
    });

    // Copy to clipboard functionality
    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const code = btn.getAttribute("data-code");
        if (code) {
          try {
            await navigator.clipboard.writeText(code);
            btn.classList.add("copied");
            setTimeout(() => {
              btn.classList.remove("copied");
            }, 1800);
          } catch (err) {
            console.error("Failed to copy command:", err);
          }
        }
      });
    });
  });
</script>

<style>
  .git-table-container {
    margin: 1.5rem 0 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-family: inherit;
  }

  .filter-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--sl-color-gray-5, rgba(255, 255, 255, 0.1));
    padding: 1rem;
    border-radius: 0.75rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--sl-color-gray-3, #9ca3af);
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    padding: 0.65rem 2.2rem 0.65rem 2.5rem;
    background: var(--sl-color-black, #111827);
    border: 1px solid var(--sl-color-gray-4, #374151);
    border-radius: 0.5rem;
    color: var(--sl-color-white, #f9fafb);
    font-size: 0.925rem;
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .search-box input:focus {
    border-color: var(--sl-color-accent, #3b82f6);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  }

  .clear-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    color: var(--sl-color-gray-3, #9ca3af);
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0 0.25rem;
    line-height: 1;
  }

  .clear-btn:hover {
    color: var(--sl-color-white, #fff);
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 0.85rem;
    box-sizing: border-box;
    line-height: 1;
    border-radius: 9999px;
    background: var(--sl-color-gray-5, rgba(255, 255, 255, 0.06));
    border: 1px solid var(--sl-color-gray-4, rgba(255, 255, 255, 0.12));
    color: var(--sl-color-gray-2, #d1d5db);
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin: 0 !important;
    flex-shrink: 0;
  }

  .pill-btn:hover {
    background: var(--sl-color-gray-4, rgba(255, 255, 255, 0.15));
    color: var(--sl-color-white, #fff);
  }

  .pill-btn.active {
    background: var(--sl-color-accent, #3b82f6);
    border-color: var(--sl-color-accent, #3b82f6);
    color: #ffffff;
  }

  .table-wrapper {
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5, rgba(255, 255, 255, 0.1));
    -webkit-overflow-scrolling: touch;
  }

  .git-quick-table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
    margin: 0 !important;
  }

  .git-quick-table th {
    background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.05));
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--sl-color-gray-2, #e5e7eb);
    border-bottom: 1px solid var(--sl-color-gray-5, rgba(255, 255, 255, 0.1));
  }

  .git-quick-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-6, rgba(255, 255, 255, 0.05));
    vertical-align: middle;
  }

  /* Explicit column width rules to prevent category wrapping */
  .col-category {
    width: 1%;
    white-space: nowrap;
    min-width: 110px;
  }

  .col-goal {
    min-width: 180px;
  }

  .col-command {
    min-width: 250px;
  }

  .git-quick-table tbody tr:hover {
    background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.04));
  }

  .category-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 0.375rem;
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    white-space: nowrap;
    line-height: 1.2;
  }

  .goal-cell {
    color: var(--sl-color-gray-2, #e5e7eb);
    font-weight: 500;
  }

  .command-cell code {
    background: var(--sl-color-black, rgba(0, 0, 0, 0.4));
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--sl-color-gray-5, rgba(255, 255, 255, 0.1));
    color: #38bdf8;
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .code-copy-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .copy-cmd-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--sl-color-gray-3, #9ca3af);
    padding: 0;
    border-radius: 0.375rem;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  tr:hover .copy-cmd-btn,
  .copy-cmd-btn:focus,
  .copy-cmd-btn.copied {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .copy-cmd-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.25);
    color: var(--sl-color-white, #fff);
  }

  .copy-cmd-btn svg {
    display: block;
    margin: auto;
    flex-shrink: 0;
  }

  .copy-cmd-btn .icon-copy {
    display: block;
  }

  .copy-cmd-btn .icon-check {
    display: none;
    color: #4ade80;
  }

  .copy-cmd-btn.copied {
    background: rgba(74, 222, 128, 0.15) !important;
    border-color: rgba(74, 222, 128, 0.4) !important;
    color: #4ade80 !important;
  }

  .copy-cmd-btn.copied .icon-copy {
    display: none;
  }

  .copy-cmd-btn.copied .icon-check {
    display: block;
    animation: pop-check 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  @keyframes pop-check {
    0% {
      transform: scale(0.5);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .no-results-msg {
    padding: 2rem;
    text-align: center;
    color: var(--sl-color-gray-3, #9ca3af);
    font-size: 0.95rem;
  }
</style>
